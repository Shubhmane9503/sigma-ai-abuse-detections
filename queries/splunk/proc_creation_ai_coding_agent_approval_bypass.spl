CommandLine IN ("*--dangerously-skip-permissions*", "*--allow-dangerously-skip-permissions*", "*--dangerously-bypass-approvals-and-sandbox*", "*--dangerously-bypass-hook-trust*", "*danger-full-access*") OR (Image IN ("*/claude", "*\\claude.exe") OR Image IN ("*/claude/versions/*", "*\\claude\\versions\\*") OR CommandLine IN ("*@anthropic-ai/claude-code*", "*@anthropic-ai\\claude-code*") CommandLine="*bypassPermissions*") OR (Image IN ("*/codex", "*\\codex.exe") OR CommandLine IN ("*@openai/codex*", "*@openai\\codex*", "*/codex.js*", "*\\codex.js*") CommandLine IN ("*--ask-for-approval never*", "*--ask-for-approval=never*", "* -a never*", "*approval_policy=never*", "*approval_policy=\"never\"*")) OR (Image IN ("*/gemini", "*\\gemini.exe") OR CommandLine IN ("*/bin/gemini*", "*@google/gemini-cli*", "*@google\\gemini-cli*", "*\\gemini.cmd*") CommandLine IN ("*-yolo*", "*--approval-mode yolo*", "*--approval-mode=yolo*", "* -y *") OR CommandLine="* -y") OR (Image IN ("*/copilot", "*\\copilot.exe") OR CommandLine IN ("*@github/copilot*", "*@github\\copilot*", "*/bin/copilot*", "*\\copilot.cmd*") CommandLine IN ("*--allow-all*", "*--yolo*")) NOT User="*allowlisted-ci-sandbox"
