ParentImage IN ("*/claude", "*\\claude.exe", "*/codex", "*\\codex.exe", "*/gemini", "*\\gemini.exe", "*/copilot", "*\\copilot.exe", "*/cursor-agent") OR ParentImage IN ("*/claude/versions/*", "*\\claude\\versions\\*") OR ParentCommandLine IN ("*@anthropic-ai/claude-code*", "*@anthropic-ai\\claude-code*", "*@openai/codex*", "*@openai\\codex*", "*@google/gemini-cli*", "*@google\\gemini-cli*", "*/bin/gemini*", "*@github/copilot*", "*@github\\copilot*", "*/bin/copilot*", "*cursor-agent*") CommandLine IN ("*.aws/credentials*", "*.aws\\credentials*", "*.azure/msal_token_cache*", "*.azure\\msal_token_cache*", "*.azure/accessTokens.json*", "*.azure\\accessTokens.json*", "*gcloud/credentials.db*", "*gcloud\\credentials.db*", "*gcloud/application_default_credentials.json*", "*gcloud\\application_default_credentials.json*", "*gcloud/legacy_credentials*", "*gcloud\\legacy_credentials*", "*.ssh/id_*", "*.ssh\\id_*", "*.kube/config*", "*.kube\\config*", "*.docker/config.json*", "*.docker\\config.json*", "*.git-credentials*", "*.netrc*", "*.npmrc*", "*.pypirc*") NOT User="*allowlisted-infra-automation"
