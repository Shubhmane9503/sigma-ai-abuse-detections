from logs-endpoint.events.process-* metadata _id, _index, _version | where to_lower(event.type) == "start" and (to_lower(process.command_line) like "*--dangerously-skip-permissions*" or to_lower(process.command_line) like "*--allow-dangerously-skip-permissions*" or to_lower(process.command_line) like "*--dangerously-bypass-approvals-and-sandbox*" or to_lower(process.command_line) like "*--dangerously-bypass-hook-trust*" or to_lower(process.command_line) like "*danger-full-access*" or (ends_with(to_lower(process.executable), "/claude") or ends_with(to_lower(process.executable), "\\claude.exe") or to_lower(process.executable) like "*/claude/versions/*" or to_lower(process.executable) like "*\\\\claude\\\\versions\\\\*" or to_lower(process.command_line) like "*@anthropic-ai/claude-code*" or to_lower(process.command_line) like "*@anthropic-ai\\\\claude-code*") and to_lower(process.command_line) like "*bypasspermissions*" or (ends_with(to_lower(process.executable), "/codex") or ends_with(to_lower(process.executable), "\\codex.exe") or to_lower(process.command_line) like "*@openai/codex*" or to_lower(process.command_line) like "*@openai\\\\codex*" or to_lower(process.command_line) like "*/codex.js*" or to_lower(process.command_line) like "*\\\\codex.js*") and (to_lower(process.command_line) like "*--ask-for-approval never*" or to_lower(process.command_line) like "*--ask-for-approval=never*" or to_lower(process.command_line) like "* -a never*" or to_lower(process.command_line) like "*approval_policy=never*" or to_lower(process.command_line) like "*approval_policy=\"never\"*") or (ends_with(to_lower(process.executable), "/gemini") or ends_with(to_lower(process.executable), "\\gemini.exe") or to_lower(process.command_line) like "*/bin/gemini*" or to_lower(process.command_line) like "*@google/gemini-cli*" or to_lower(process.command_line) like "*@google\\\\gemini-cli*" or to_lower(process.command_line) like "*\\\\gemini.cmd*") and (to_lower(process.command_line) like "*-yolo*" or to_lower(process.command_line) like "*--approval-mode yolo*" or to_lower(process.command_line) like "*--approval-mode=yolo*" or to_lower(process.command_line) like "* -y *" or ends_with(to_lower(process.command_line), " -y")) or (ends_with(to_lower(process.executable), "/copilot") or ends_with(to_lower(process.executable), "\\copilot.exe") or to_lower(process.command_line) like "*@github/copilot*" or to_lower(process.command_line) like "*@github\\\\copilot*" or to_lower(process.command_line) like "*/bin/copilot*" or to_lower(process.command_line) like "*\\\\copilot.cmd*") and (to_lower(process.command_line) like "*--allow-all*" or to_lower(process.command_line) like "*--yolo*")) and not ends_with(to_lower(user.name), "allowlisted-ci-sandbox")
