from logs-endpoint.events.process-* metadata _id, _index, _version | where event.type=="start" and (process.command_line like "*--dangerously-skip-permissions*" or process.command_line like "*--allow-dangerously-skip-permissions*" or process.command_line like "*--dangerously-bypass-approvals-and-sandbox*" or process.command_line like "*--dangerously-bypass-hook-trust*" or process.command_line like "*danger-full-access*" or (ends_with(process.executable, "/claude") or ends_with(process.executable, "\\claude.exe") or process.executable like "*/claude/versions/*" or process.executable like "*\\claude\\versions\\*" or process.command_line like "*@anthropic-ai/claude-code*" or process.command_line like "*@anthropic-ai\\claude-code*") and process.command_line like "*bypassPermissions*" or (ends_with(process.executable, "/codex") or ends_with(process.executable, "\\codex.exe") or process.command_line like "*@openai/codex*" or process.command_line like "*@openai\\codex*" or process.command_line like "*/codex.js*" or process.command_line like "*\\codex.js*") and (process.command_line like "*--ask-for-approval never*" or process.command_line like "*--ask-for-approval=never*" or process.command_line like "* -a never*" or process.command_line like "*approval_policy=never*" or process.command_line like "*approval_policy=\"never\"*") or (ends_with(process.executable, "/gemini") or ends_with(process.executable, "\\gemini.exe") or process.command_line like "*/bin/gemini*" or process.command_line like "*@google/gemini-cli*" or process.command_line like "*@google\\gemini-cli*" or process.command_line like "*\\gemini.cmd*") and (process.command_line like "*-yolo*" or process.command_line like "*--approval-mode yolo*" or process.command_line like "*--approval-mode=yolo*" or process.command_line like "* -y *" or ends_with(process.command_line, " -y")) or (ends_with(process.executable, "/copilot") or ends_with(process.executable, "\\copilot.exe") or process.command_line like "*@github/copilot*" or process.command_line like "*@github\\copilot*" or process.command_line like "*/bin/copilot*" or process.command_line like "*\\copilot.cmd*") and (process.command_line like "*--allow-all*" or process.command_line like "*--yolo*")) and not ends_with(user.name, "allowlisted-ci-sandbox")
