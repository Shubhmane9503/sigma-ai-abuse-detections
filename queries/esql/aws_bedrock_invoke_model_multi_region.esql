from logs-aws.cloudtrail-* metadata _id, _index, _version | where to_lower(event.provider) == "bedrock.amazonaws.com" and (to_lower(event.action) in ("invokemodel", "invokemodelwithresponsestream", "converse", "conversestream")) and not starts_with(to_lower(aws.cloudtrail.user_identity.arn), "arn:aws:sts::111122223333:assumed-role/allowlisted-multi-region-inference/")
| stats value_count=count_distinct(cloud.region) by aws.cloudtrail.user_identity.arn
| where value_count >= 3
