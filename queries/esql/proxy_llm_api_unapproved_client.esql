from logs-* metadata _id, _index, _version | where (url.domain in ("api.openai.com", "api.anthropic.com", "generativelanguage.googleapis.com", "api.mistral.ai", "api.cohere.com", "api.cohere.ai", "api.groq.com", "api.together.xyz", "api.together.ai", "openrouter.ai", "api.deepseek.com", "api.x.ai", "api.perplexity.ai", "api.fireworks.ai") or ends_with(url.domain, ".openai.azure.com") or ends_with(url.domain, ".services.ai.azure.com")) and not source.ip=="192.0.2.10"
