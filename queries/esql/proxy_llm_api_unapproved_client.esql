from logs-* metadata _id, _index, _version | where (to_lower(url.domain) in ("api.openai.com", "api.anthropic.com", "generativelanguage.googleapis.com", "api.mistral.ai", "api.cohere.com", "api.cohere.ai", "api.groq.com", "api.together.xyz", "api.together.ai", "openrouter.ai", "api.deepseek.com", "api.x.ai", "api.perplexity.ai", "api.fireworks.ai", "aiplatform.googleapis.com", "router.huggingface.co", "api-inference.huggingface.co") or starts_with(to_lower(url.domain), "api.openai.com:") or starts_with(to_lower(url.domain), "api.anthropic.com:") or starts_with(to_lower(url.domain), "generativelanguage.googleapis.com:") or starts_with(to_lower(url.domain), "api.mistral.ai:") or starts_with(to_lower(url.domain), "api.cohere.com:") or starts_with(to_lower(url.domain), "api.cohere.ai:") or starts_with(to_lower(url.domain), "api.groq.com:") or starts_with(to_lower(url.domain), "api.together.xyz:") or starts_with(to_lower(url.domain), "api.together.ai:") or starts_with(to_lower(url.domain), "openrouter.ai:") or starts_with(to_lower(url.domain), "api.deepseek.com:") or starts_with(to_lower(url.domain), "api.x.ai:") or starts_with(to_lower(url.domain), "api.perplexity.ai:") or starts_with(to_lower(url.domain), "api.fireworks.ai:") or starts_with(to_lower(url.domain), "aiplatform.googleapis.com:") or starts_with(to_lower(url.domain), "router.huggingface.co:") or starts_with(to_lower(url.domain), "api-inference.huggingface.co:") or ends_with(to_lower(url.domain), ".openai.azure.com") or ends_with(to_lower(url.domain), ".services.ai.azure.com") or ends_with(to_lower(url.domain), "-aiplatform.googleapis.com") or ends_with(to_lower(url.domain), ".endpoints.huggingface.cloud") or ends_with(to_lower(url.domain), ".openai.azure.com:443") or ends_with(to_lower(url.domain), ".services.ai.azure.com:443") or ends_with(to_lower(url.domain), "-aiplatform.googleapis.com:443") or ends_with(to_lower(url.domain), ".endpoints.huggingface.cloud:443") or starts_with(to_lower(url.domain), "bedrock-runtime") and (ends_with(to_lower(url.domain), ".amazonaws.com") or ends_with(to_lower(url.domain), ".amazonaws.com:443") or ends_with(to_lower(url.domain), ".amazonaws.com.cn") or ends_with(to_lower(url.domain), ".amazonaws.com.cn:443") or ends_with(to_lower(url.domain), ".api.aws") or ends_with(to_lower(url.domain), ".api.aws:443")) or starts_with(to_lower(url.domain), "aiplatform.") and (ends_with(to_lower(url.domain), ".rep.googleapis.com") or ends_with(to_lower(url.domain), ".rep.googleapis.com:443"))) and not to_lower(source.ip) == "192.0.2.10"
