from logs-endpoint.events.file-* metadata _id, _index, _version | where (ends_with(to_lower(file.path), "/.claude.json") or ends_with(to_lower(file.path), "\\.claude.json") or ends_with(to_lower(file.path), "/.mcp.json") or ends_with(to_lower(file.path), "\\.mcp.json") or ends_with(to_lower(file.path), "/managed-mcp.json") or ends_with(to_lower(file.path), "\\managed-mcp.json") or ends_with(to_lower(file.path), "/.claude/settings.json") or ends_with(to_lower(file.path), "\\.claude\\settings.json") or ends_with(to_lower(file.path), "/.claude/settings.local.json") or ends_with(to_lower(file.path), "\\.claude\\settings.local.json") or ends_with(to_lower(file.path), "/claude_desktop_config.json") or ends_with(to_lower(file.path), "\\claude_desktop_config.json") or ends_with(to_lower(file.path), "/.cursor/mcp.json") or ends_with(to_lower(file.path), "\\.cursor\\mcp.json") or ends_with(to_lower(file.path), "/.codeium/windsurf/mcp_config.json") or ends_with(to_lower(file.path), "\\.codeium\\windsurf\\mcp_config.json") or ends_with(to_lower(file.path), "/.vscode/mcp.json") or ends_with(to_lower(file.path), "\\.vscode\\mcp.json") or ends_with(to_lower(file.path), "/.gemini/settings.json") or ends_with(to_lower(file.path), "\\.gemini\\settings.json") or ends_with(to_lower(file.path), "/.codex/config.toml") or ends_with(to_lower(file.path), "\\.codex\\config.toml")) and not (ends_with(to_lower(process.executable), "/claude") or ends_with(to_lower(process.executable), "\\claude.exe") or ends_with(to_lower(process.executable), "/cursor") or ends_with(to_lower(process.executable), "\\cursor.exe") or ends_with(to_lower(process.executable), "/cursor helper (plugin)") or ends_with(to_lower(process.executable), "/code") or ends_with(to_lower(process.executable), "\\code.exe") or ends_with(to_lower(process.executable), "/code helper (plugin)") or ends_with(to_lower(process.executable), "/windsurf") or ends_with(to_lower(process.executable), "\\windsurf.exe") or ends_with(to_lower(process.executable), "/windsurf helper (plugin)") or ends_with(to_lower(process.executable), "/codex") or ends_with(to_lower(process.executable), "\\codex.exe") or to_lower(process.executable) like "*/claude/versions/*" or to_lower(process.executable) like "*\\\\claude\\\\versions\\\\*") and not ends_with(to_lower(process.executable), "/allowlisted-config-manager")
