from logs-endpoint.events.file-* metadata _id, _index, _version | where (ends_with(to_lower(file.path), "/.claude.json") or ends_with(to_lower(file.path), "\\.claude.json") or ends_with(to_lower(file.path), "/.mcp.json") or ends_with(to_lower(file.path), "\\.mcp.json") or ends_with(to_lower(file.path), "/managed-mcp.json") or ends_with(to_lower(file.path), "\\managed-mcp.json") or ends_with(to_lower(file.path), "/.claude/settings.json") or ends_with(to_lower(file.path), "\\.claude\\settings.json") or ends_with(to_lower(file.path), "/.claude/settings.local.json") or ends_with(to_lower(file.path), "\\.claude\\settings.local.json") or ends_with(to_lower(file.path), "/claude_desktop_config.json") or ends_with(to_lower(file.path), "\\claude_desktop_config.json") or ends_with(to_lower(file.path), "/.cursor/mcp.json") or ends_with(to_lower(file.path), "\\.cursor\\mcp.json") or ends_with(to_lower(file.path), "/.codeium/windsurf/mcp_config.json") or ends_with(to_lower(file.path), "\\.codeium\\windsurf\\mcp_config.json") or ends_with(to_lower(file.path), "/.vscode/mcp.json") or ends_with(to_lower(file.path), "\\.vscode\\mcp.json") or ends_with(to_lower(file.path), "/.gemini/settings.json") or ends_with(to_lower(file.path), "\\.gemini\\settings.json") or ends_with(to_lower(file.path), "/.codex/config.toml") or ends_with(to_lower(file.path), "\\.codex\\config.toml")) and not (to_lower(process.executable) like "*/.local/share/claude/versions/*" or to_lower(process.executable) like "*\\\\.local\\\\share\\\\claude\\\\versions\\\\*" or to_lower(process.executable) like "*/node_modules/@anthropic-ai/claude-code*" or to_lower(process.executable) like "*\\\\node_modules\\\\@anthropic-ai\\\\claude-code*" or to_lower(process.executable) like "*/node_modules/@openai/codex*" or to_lower(process.executable) like "*\\\\node_modules\\\\@openai\\\\codex*" or starts_with(to_lower(process.executable), "/applications/claude.app/contents/") or starts_with(to_lower(process.executable), "/applications/cursor.app/contents/") or starts_with(to_lower(process.executable), "/applications/visual studio code.app/contents/") or starts_with(to_lower(process.executable), "/applications/windsurf.app/contents/") or to_lower(process.executable) like "*\\\\appdata\\\\local\\\\anthropicclaude\\\\*" or to_lower(process.executable) like "*\\\\appdata\\\\local\\\\programs\\\\cursor\\\\*" or to_lower(process.executable) like "*\\\\appdata\\\\local\\\\programs\\\\microsoft vs code\\\\*" or to_lower(process.executable) like "*\\\\appdata\\\\local\\\\programs\\\\windsurf\\\\*" or starts_with(to_lower(process.executable), "c:\\program files\\microsoft vs code\\") or starts_with(to_lower(process.executable), "/usr/share/code/") or starts_with(to_lower(process.executable), "/snap/code/") or starts_with(to_lower(process.executable), "/usr/share/cursor/") or starts_with(to_lower(process.executable), "/opt/cursor/") or starts_with(to_lower(process.executable), "/usr/share/windsurf/")) and not ends_with(to_lower(process.executable), "/allowlisted-config-manager")
