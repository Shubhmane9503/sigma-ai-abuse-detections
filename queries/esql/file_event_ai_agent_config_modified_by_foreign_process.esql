from logs-endpoint.events.file-* metadata _id, _index, _version | where (ends_with(file.path, "/.claude.json") or ends_with(file.path, "\\.claude.json") or ends_with(file.path, "/.mcp.json") or ends_with(file.path, "\\.mcp.json") or ends_with(file.path, "/managed-mcp.json") or ends_with(file.path, "\\managed-mcp.json") or ends_with(file.path, "/.claude/settings.json") or ends_with(file.path, "\\.claude\\settings.json") or ends_with(file.path, "/.claude/settings.local.json") or ends_with(file.path, "\\.claude\\settings.local.json") or ends_with(file.path, "/claude_desktop_config.json") or ends_with(file.path, "\\claude_desktop_config.json") or ends_with(file.path, "/.cursor/mcp.json") or ends_with(file.path, "\\.cursor\\mcp.json") or ends_with(file.path, "/.codeium/windsurf/mcp_config.json") or ends_with(file.path, "\\.codeium\\windsurf\\mcp_config.json") or ends_with(file.path, "/.vscode/mcp.json") or ends_with(file.path, "\\.vscode\\mcp.json") or ends_with(file.path, "/.gemini/settings.json") or ends_with(file.path, "\\.gemini\\settings.json") or ends_with(file.path, "/.codex/config.toml") or ends_with(file.path, "\\.codex\\config.toml")) and not (ends_with(process.executable, "/claude") or ends_with(process.executable, "\\claude.exe") or ends_with(process.executable, "/cursor") or ends_with(process.executable, "\\cursor.exe") or ends_with(process.executable, "/Cursor Helper (Plugin)") or ends_with(process.executable, "/code") or ends_with(process.executable, "\\code.exe") or ends_with(process.executable, "/Code Helper (Plugin)") or ends_with(process.executable, "/windsurf") or ends_with(process.executable, "\\windsurf.exe") or ends_with(process.executable, "/Windsurf Helper (Plugin)") or ends_with(process.executable, "/codex") or ends_with(process.executable, "\\codex.exe") or process.executable like "*/claude/versions/*" or process.executable like "*\\claude\\versions\\*") and not ends_with(process.executable, "/allowlisted-config-manager")
