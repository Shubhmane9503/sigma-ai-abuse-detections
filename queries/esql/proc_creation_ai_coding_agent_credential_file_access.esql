from logs-endpoint.events.process-* metadata _id, _index, _version | where to_lower(event.type) == "start" and (ends_with(to_lower(process.parent.executable), "/claude") or ends_with(to_lower(process.parent.executable), "\\claude.exe") or ends_with(to_lower(process.parent.executable), "/codex") or ends_with(to_lower(process.parent.executable), "\\codex.exe") or ends_with(to_lower(process.parent.executable), "/gemini") or ends_with(to_lower(process.parent.executable), "\\gemini.exe") or ends_with(to_lower(process.parent.executable), "/copilot") or ends_with(to_lower(process.parent.executable), "\\copilot.exe") or ends_with(to_lower(process.parent.executable), "/cursor-agent") or to_lower(process.parent.executable) like "*/claude/versions/*" or to_lower(process.parent.executable) like "*\\\\claude\\\\versions\\\\*" or to_lower(process.parent.command_line) like "*@anthropic-ai/claude-code*" or to_lower(process.parent.command_line) like "*@anthropic-ai\\\\claude-code*" or to_lower(process.parent.command_line) like "*@openai/codex*" or to_lower(process.parent.command_line) like "*@openai\\\\codex*" or to_lower(process.parent.command_line) like "*@google/gemini-cli*" or to_lower(process.parent.command_line) like "*@google\\\\gemini-cli*" or to_lower(process.parent.command_line) like "*/bin/gemini*" or to_lower(process.parent.command_line) like "*@github/copilot*" or to_lower(process.parent.command_line) like "*@github\\\\copilot*" or to_lower(process.parent.command_line) like "*/bin/copilot*" or to_lower(process.parent.command_line) like "*cursor-agent*") and (to_lower(process.command_line) like "*.aws/credentials*" or to_lower(process.command_line) like "*.aws\\\\credentials*" or to_lower(process.command_line) like "*.azure/msal_token_cache*" or to_lower(process.command_line) like "*.azure\\\\msal_token_cache*" or to_lower(process.command_line) like "*.azure/accesstokens.json*" or to_lower(process.command_line) like "*.azure\\\\accesstokens.json*" or to_lower(process.command_line) like "*gcloud/credentials.db*" or to_lower(process.command_line) like "*gcloud\\\\credentials.db*" or to_lower(process.command_line) like "*gcloud/application_default_credentials.json*" or to_lower(process.command_line) like "*gcloud\\\\application_default_credentials.json*" or to_lower(process.command_line) like "*gcloud/legacy_credentials*" or to_lower(process.command_line) like "*gcloud\\\\legacy_credentials*" or to_lower(process.command_line) like "*.kube/config*" or to_lower(process.command_line) like "*.kube\\\\config*" or to_lower(process.command_line) like "*.docker/config.json*" or to_lower(process.command_line) like "*.docker\\\\config.json*" or to_lower(process.command_line) like "*.git-credentials*" or to_lower(process.command_line) like "*.netrc*" or to_lower(process.command_line) like "*.npmrc*" or to_lower(process.command_line) like "*.pypirc*" or to_lower(process.command_line) like "*.ssh/id_rsa *" or to_lower(process.command_line) like "*.ssh/id_rsa'*" or to_lower(process.command_line) like "*.ssh/id_rsa\"*" or to_lower(process.command_line) like "*.ssh/id_rsa;*" or to_lower(process.command_line) like "*.ssh/id_rsa|*" or to_lower(process.command_line) like "*.ssh/id_rsa)*" or to_lower(process.command_line) like "*.ssh/id_rsa&*" or to_lower(process.command_line) like "*.ssh\\\\id_rsa *" or to_lower(process.command_line) like "*.ssh\\\\id_rsa'*" or to_lower(process.command_line) like "*.ssh\\\\id_rsa\"*" or to_lower(process.command_line) like "*.ssh\\\\id_rsa;*" or to_lower(process.command_line) like "*.ssh\\\\id_rsa|*" or to_lower(process.command_line) like "*.ssh\\\\id_rsa)*" or to_lower(process.command_line) like "*.ssh\\\\id_rsa&*" or to_lower(process.command_line) like "*.ssh/id_ed25519 *" or to_lower(process.command_line) like "*.ssh/id_ed25519'*" or to_lower(process.command_line) like "*.ssh/id_ed25519\"*" or to_lower(process.command_line) like "*.ssh/id_ed25519;*" or to_lower(process.command_line) like "*.ssh/id_ed25519|*" or to_lower(process.command_line) like "*.ssh/id_ed25519)*" or to_lower(process.command_line) like "*.ssh/id_ed25519&*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519 *" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519'*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519\"*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519;*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519|*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519)*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519&*" or to_lower(process.command_line) like "*.ssh/id_ecdsa *" or to_lower(process.command_line) like "*.ssh/id_ecdsa'*" or to_lower(process.command_line) like "*.ssh/id_ecdsa\"*" or to_lower(process.command_line) like "*.ssh/id_ecdsa;*" or to_lower(process.command_line) like "*.ssh/id_ecdsa|*" or to_lower(process.command_line) like "*.ssh/id_ecdsa)*" or to_lower(process.command_line) like "*.ssh/id_ecdsa&*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa *" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa'*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa\"*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa;*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa|*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa)*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa&*" or to_lower(process.command_line) like "*.ssh/id_dsa *" or to_lower(process.command_line) like "*.ssh/id_dsa'*" or to_lower(process.command_line) like "*.ssh/id_dsa\"*" or to_lower(process.command_line) like "*.ssh/id_dsa;*" or to_lower(process.command_line) like "*.ssh/id_dsa|*" or to_lower(process.command_line) like "*.ssh/id_dsa)*" or to_lower(process.command_line) like "*.ssh/id_dsa&*" or to_lower(process.command_line) like "*.ssh\\\\id_dsa *" or to_lower(process.command_line) like "*.ssh\\\\id_dsa'*" or to_lower(process.command_line) like "*.ssh\\\\id_dsa\"*" or to_lower(process.command_line) like "*.ssh\\\\id_dsa;*" or to_lower(process.command_line) like "*.ssh\\\\id_dsa|*" or to_lower(process.command_line) like "*.ssh\\\\id_dsa)*" or to_lower(process.command_line) like "*.ssh\\\\id_dsa&*" or to_lower(process.command_line) like "*.ssh/id_ecdsa_sk *" or to_lower(process.command_line) like "*.ssh/id_ecdsa_sk'*" or to_lower(process.command_line) like "*.ssh/id_ecdsa_sk\"*" or to_lower(process.command_line) like "*.ssh/id_ecdsa_sk;*" or to_lower(process.command_line) like "*.ssh/id_ecdsa_sk|*" or to_lower(process.command_line) like "*.ssh/id_ecdsa_sk)*" or to_lower(process.command_line) like "*.ssh/id_ecdsa_sk&*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa_sk *" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa_sk'*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa_sk\"*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa_sk;*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa_sk|*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa_sk)*" or to_lower(process.command_line) like "*.ssh\\\\id_ecdsa_sk&*" or to_lower(process.command_line) like "*.ssh/id_ed25519_sk *" or to_lower(process.command_line) like "*.ssh/id_ed25519_sk'*" or to_lower(process.command_line) like "*.ssh/id_ed25519_sk\"*" or to_lower(process.command_line) like "*.ssh/id_ed25519_sk;*" or to_lower(process.command_line) like "*.ssh/id_ed25519_sk|*" or to_lower(process.command_line) like "*.ssh/id_ed25519_sk)*" or to_lower(process.command_line) like "*.ssh/id_ed25519_sk&*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519_sk *" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519_sk'*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519_sk\"*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519_sk;*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519_sk|*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519_sk)*" or to_lower(process.command_line) like "*.ssh\\\\id_ed25519_sk&*" or ends_with(to_lower(process.command_line), ".ssh/id_rsa") or ends_with(to_lower(process.command_line), ".ssh\\id_rsa") or ends_with(to_lower(process.command_line), ".ssh/id_ed25519") or ends_with(to_lower(process.command_line), ".ssh\\id_ed25519") or ends_with(to_lower(process.command_line), ".ssh/id_ecdsa") or ends_with(to_lower(process.command_line), ".ssh\\id_ecdsa") or ends_with(to_lower(process.command_line), ".ssh/id_dsa") or ends_with(to_lower(process.command_line), ".ssh\\id_dsa") or ends_with(to_lower(process.command_line), ".ssh/id_ecdsa_sk") or ends_with(to_lower(process.command_line), ".ssh\\id_ecdsa_sk") or ends_with(to_lower(process.command_line), ".ssh/id_ed25519_sk") or ends_with(to_lower(process.command_line), ".ssh\\id_ed25519_sk")) and not ends_with(to_lower(user.name), "allowlisted-infra-automation")
