from logs-endpoint.events.process-* metadata _id, _index, _version | where event.type=="start" and (ends_with(process.parent.executable, "/claude") or ends_with(process.parent.executable, "\\claude.exe") or ends_with(process.parent.executable, "/codex") or ends_with(process.parent.executable, "\\codex.exe") or ends_with(process.parent.executable, "/gemini") or ends_with(process.parent.executable, "\\gemini.exe") or ends_with(process.parent.executable, "/copilot") or ends_with(process.parent.executable, "\\copilot.exe") or ends_with(process.parent.executable, "/cursor-agent") or process.parent.executable like "*/claude/versions/*" or process.parent.executable like "*\\claude\\versions\\*" or process.parent.command_line like "*@anthropic-ai/claude-code*" or process.parent.command_line like "*@anthropic-ai\\claude-code*" or process.parent.command_line like "*@openai/codex*" or process.parent.command_line like "*@openai\\codex*" or process.parent.command_line like "*@google/gemini-cli*" or process.parent.command_line like "*@google\\gemini-cli*" or process.parent.command_line like "*/bin/gemini*" or process.parent.command_line like "*@github/copilot*" or process.parent.command_line like "*@github\\copilot*" or process.parent.command_line like "*/bin/copilot*" or process.parent.command_line like "*cursor-agent*") and (process.command_line like "*.aws/credentials*" or process.command_line like "*.aws\\credentials*" or process.command_line like "*.azure/msal_token_cache*" or process.command_line like "*.azure\\msal_token_cache*" or process.command_line like "*.azure/accessTokens.json*" or process.command_line like "*.azure\\accessTokens.json*" or process.command_line like "*gcloud/credentials.db*" or process.command_line like "*gcloud\\credentials.db*" or process.command_line like "*gcloud/application_default_credentials.json*" or process.command_line like "*gcloud\\application_default_credentials.json*" or process.command_line like "*gcloud/legacy_credentials*" or process.command_line like "*gcloud\\legacy_credentials*" or process.command_line like "*.ssh/id_*" or process.command_line like "*.ssh\\id_*" or process.command_line like "*.kube/config*" or process.command_line like "*.kube\\config*" or process.command_line like "*.docker/config.json*" or process.command_line like "*.docker\\config.json*" or process.command_line like "*.git-credentials*" or process.command_line like "*.netrc*" or process.command_line like "*.npmrc*" or process.command_line like "*.pypirc*") and not ends_with(user.name, "allowlisted-infra-automation")
