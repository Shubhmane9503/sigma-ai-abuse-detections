from logs-aws.cloudtrail-* metadata _id, _index, _version | where to_lower(event.provider) == "bedrock.amazonaws.com" and (to_lower(event.action) in ("putusecaseformodelaccess", "createfoundationmodelagreement", "putfoundationmodelentitlement")) and not starts_with(to_lower(aws.cloudtrail.user_identity.arn), "arn:aws:sts::111122223333:assumed-role/allowlisted-ai-platform-admin/")
