from * metadata _id, _index, _version | where (to_lower(OperationNameValue) in ("microsoft.cognitiveservices/accounts/listkeys/action", "microsoft.cognitiveservices/accounts/regeneratekey/action")) and to_lower(ActivityStatusValue) == "success" and not (to_lower(Caller) in ("00000000-0000-0000-0000-00000000a110", "allowlisted-key-rotation@example.com"))
